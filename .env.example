# Don't change these values unless you know what you are doing !

# --------------------
# Discord Bot Config
# --------------------
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --------------------
# Database Config
# --------------------
DB_NAME=
DB_USER=

# --------------------
# App Environment : Either development or production
# --------------------
NODE_ENV=

# --------------------
# Libre translate config
# --------------------
LIBRETRANSLATE_URL=http://shiveron-libretranslate:5000

# Number of CPU threads LibreTranslate may use for inference. Translation is CPU-bound, and this is the single biggest lever on translation latency. Set it to the cores the host can spare. Defaults to 4 when left empty.
LT_THREADS=

# Comma-separated language codes to load, e.g. en,fr,de. Empty loads every language, which is the safe default.
LT_LOAD_ONLY=