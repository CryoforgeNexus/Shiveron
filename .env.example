# Don't change these values unless you know what you are doing !

# --------------------
# Discord Bot Config
# --------------------
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --------------------
# Database Config
# --------------------
DB_NAME=
DB_USER=

# --------------------
# App Environment : Either development or production
# --------------------
NODE_ENV=

# --------------------
# Libre translate config
# --------------------
LIBRETRANSLATE_URL=http://shiveron-libretranslate:5000

# Number of CPU threads LibreTranslate may use for inference. Translation is CPU-bound, and this is the single biggest lever on translation latency. Set it to the cores the host can spare. Defaults to 4 when left empty.
LT_THREADS=

# Comma-separated language codes to load, e.g. en,fr,de. Restricting the set lowers memory use and startup time, but any language left out can no longer be detected or translated. Leave this line commented out to keep every language, which is the safe default. Do not set it to an empty value: LibreTranslate reads "" as a language code, installs no models and refuses to start.
# LT_LOAD_ONLY=
