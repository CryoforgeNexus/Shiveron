{
	"name": "shiveron",
	"version": "1.2.0",
	"description": "Modular and multipurpose Discord Bot, built using discord.js v14",
	"main": "dist/bot.js",
	"scripts": {
		"start": "npm run build && node .",
		"build": "node -e \"const fs=require('fs'); fs.rmSync('./dist', {recursive:true, force:true})\" && tsc && node -e \"const fs=require('fs'); fs.cpSync('./src/locales', './dist/locales', {recursive: true})\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"keywords": [
		"discord",
		"discord-bot",
		"discordjs",
		"moderation",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://git.cryoforgenexus.com/Shiveron/shiveron.git"
	},
	"author": "Cryoforge Nexus",
	"license": "MIT",
	"bugs": {
		"url": "https://git.cryoforgenexus.com/Shiveron/shiveron/issues"
	},
	"homepage": "https://git.cryoforgenexus.com/Shiveron/shiveron#readme",
	"type": "module",
	"dependencies": {
		"async-lock": "^1.4.1",
		"discord.js": "^14.27.0",
		"pg": "^8.23.0",
		"sequelize": "^6.37.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/async-lock": "^1.4.2",
		"@types/node": "^25.9.7",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "10.1.8",
		"jiti": "^2.7.0",
		"prettier": "3.9.7",
		"typescript": "^6.0.3"
	}
}
