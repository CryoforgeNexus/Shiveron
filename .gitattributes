# Enforce LF line endings repo-wide.
* text=auto eol=lf

# Shell scripts must keep LF even on Windows checkouts — CRLF breaks the shebang.
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Generated, and noisy in diffs.
package-lock.json linguist-generated=true -diff

# --- Git LFS-tracked binary assets ---
# Images
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.tiff   filter=lfs diff=lfs merge=lfs -text
*.tif    filter=lfs diff=lfs merge=lfs -text
*.bmp    filter=lfs diff=lfs merge=lfs -text
*.ico    filter=lfs diff=lfs merge=lfs -text
# SVG is XML — it stays in regular Git so diffs remain readable.
*.svg    text
# Fonts
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.otf    filter=lfs diff=lfs merge=lfs -text
*.woff   filter=lfs diff=lfs merge=lfs -text
*.woff2  filter=lfs diff=lfs merge=lfs -text
# Audio
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.flac   filter=lfs diff=lfs merge=lfs -text
*.opus   filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
# Video
*.mp4    filter=lfs diff=lfs merge=lfs -text
*.webm   filter=lfs diff=lfs merge=lfs -text
*.mov    filter=lfs diff=lfs merge=lfs -text

# --- Excluded from `git archive` release tarballs ---
.gitattributes    export-ignore
.gitignore        export-ignore
.forgejo/         export-ignore
.prettierignore   export-ignore
.prettierrc.json  export-ignore
eslint.config.ts  export-ignore
AGENTS.md         export-ignore
CLAUDE.md         export-ignore
CONTRIBUTING.md   export-ignore
CODE_OF_CONDUCT.md export-ignore
SECURITY.md       export-ignore
